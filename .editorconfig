# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# TypeScript and JavaScript files
[*.{ts,js,mts,cts}]
indent_size = 2
quote_type = single

# JSON files
[*.{json,jsonc}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# C/C++ files
[*.{c,h,cpp,hpp,cc,cxx}]
indent_size = 2
indent_style = space

# Shell scripts
[*.sh]
indent_size = 2

# Configuration files
[{Makefile,makefile,*.mk}]
indent_style = tab
indent_size = 4

# Python files (if any)
[*.py]
indent_size = 4

# WebAssembly text format
[*.{wat,wast}]
indent_size = 2